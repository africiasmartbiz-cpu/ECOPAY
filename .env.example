# Secret cryptographique JWT (Obligatoire en production : clé aléatoire forte de 32 octets minimum)
JWT_SECRET="remplacez_par_une_cle_secrete_aleatoire_de_32_octets_minimum"
JWT_EXPIRES_IN="7d"

# Configuration Régionale Togo / UEMOA
DEFAULT_CURRENCY="XOF"
DEFAULT_TIMEZONE="Africa/Lome"
DEFAULT_COUNTRY_CODE="+228"

# URL publique de production de l'application
NEXT_PUBLIC_APP_URL="https://ecofrais.tg"

# Identifiants Super-Administrateur (Strictement privés au serveur Node.js — jamais exposés au public)
SUPERADMIN_EMAIL="superadmin@ecofrais.tg"
SUPERADMIN_PASSWORD="VotreMotDePasseSuperAdminUltraSecurise2025!"

# Base de données de production (Optionnel si PostgreSQL / MySQL)
# DATABASE_URL="postgresql://user:password@host:5432/ecofrais_db?sslmode=require"
